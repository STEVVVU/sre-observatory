{
  "service": "sre-observatory",
  "period_days": 30,
  "metrics": {
    "request_counter": "http_server_requests_total",
    "request_duration_histogram": "http_server_request_duration_seconds",
    "route_filter": "/healthz|/readyz|/metrics"
  },
  "indicators": [
    {
      "name": "availability",
      "type": "availability",
      "objective": 0.999
    },
    {
      "name": "latency",
      "type": "latency",
      "objective": 0.99,
      "threshold_seconds": 0.3
    }
  ],
  "alert_windows": [
    {
      "long": "1h",
      "short": "5m",
      "burn_rate": 14.4,
      "severity": "page"
    },
    {
      "long": "6h",
      "short": "30m",
      "burn_rate": 6.0,
      "severity": "page"
    },
    {
      "long": "1d",
      "short": "2h",
      "burn_rate": 3.0,
      "severity": "ticket"
    },
    {
      "long": "3d",
      "short": "6h",
      "burn_rate": 1.0,
      "severity": "ticket"
    }
  ],
  "runbook_url": "https://github.com/STEVVVU/sre-observatory/blob/main/docs/runbooks/high-error-budget-burn.md"
}
