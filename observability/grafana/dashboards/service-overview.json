      "targets": [
        {
          "expr": "1 - (sum(rate(http_server_requests_total{route!~=\"/healthz|/readyz|/metrics\",status_code=~=\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_total{route!~=\"/healthz|/readyz|/metrics\"}[5m])), 1e-9))",
